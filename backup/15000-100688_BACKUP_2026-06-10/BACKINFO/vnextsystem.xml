<!--XML file to hold the vNEXT configurations -->
<vNEXT>
  <USER name="">
    <ProgrammableKeys>
      <Key_1 friendlyName="PLC Reset">
        <type>Output</type>
        <allowInAuto>Yes</allowInAuto>
        <pressed>PressOrRelease</pressed>
        <target>do_PLC1_RobResetFP1</target>
      </Key_1>
      <Key_2 friendlyName="">
        <type>None</type>
        <allowInAuto>No</allowInAuto>
        <pressed></pressed>
        <target></target>
      </Key_2>
      <Key_3 friendlyName="">
        <type>None</type>
        <allowInAuto>No</allowInAuto>
        <pressed></pressed>
        <target></target>
      </Key_3>
      <Key_4 friendlyName="PP-Main">
        <type>System</type>
        <allowInAuto>Yes</allowInAuto>
        <pressed>MovePPtoMain</pressed>
        <target></target>
      </Key_4>
    </ProgrammableKeys>
    <BackgroundImage>
      <location>(HOME$)/SampleImage.gif</location>
    </BackgroundImage>
    <BackupRestorePath>
      <LastPath>D:\Backups</LastPath>
    </BackupRestorePath>
    <DefaultPath>
      <RapidModules>/HOME</RapidModules>
      <RapidPrograms>/HOME</RapidPrograms>
      <ConfigurationFiles>/HOME</ConfigurationFiles>
    </DefaultPath>
    <StartUpAppEvent>
      <SwitchAuto Name="" />
      <SwitchManual Name="" />
      <SwitchManualFS Name="" />
      <Startup Name="" />
    </StartUpAppEvent>
  </USER>
</vNEXT>